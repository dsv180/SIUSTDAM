# Образец: скопируйте в gateway.env рядом со скриптами и вставьте свои значения.
# НИКОГДА не коммитьте gateway.env с настоящими ключами.

# ── LLM для экстракции памяти (OpenAI-совместимый) ──
TDAI_LLM_API_KEY=sk-ВСТАВЬТЕ-КЛЮЧ

# ── Служебные переключатели пилота ──
TDAI_LLM_REASONING=none            # служебные вызовы без рассуждений (AITUNNEL reasoning.md)
TDAI_SKILL_ENABLED=true            # скилл-модуль шлюза (вкладка Скиллы)
TDAI_TOOL_CAPTURE_SUCCESS=0        # 0 = в память пишутся только ОШИБКИ инструментов

# ── Администратор Memory Hub (создаётся init-admin, сюда записать вручную) ──
TDAI_ADMIN_USER_KEY=sk-mem-ВАШ-АДМИН-КЛЮЧ

# Gateway API key for remote clients (Authorization: Bearer).
# Empty = auth disabled (only for loopback-only deployments).
TDAI_GATEWAY_API_KEY=
